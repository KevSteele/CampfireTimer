# BigWigs packager configuration (https://github.com/BigWigsMods/packager).
# The repository holds the addon in the folder CampfireTimer. The packager
# copies the repository into .release/CampfireTimer, then moves the addon
# folder up one level, so the zip has CampfireTimer/CampfireTimer.toc.
package-as: CampfireTimer

move-folders:
  CampfireTimer/CampfireTimer: CampfireTimer

enable-nolib-creation: no

manual-changelog: CHANGELOG.md

ignore:
  - .github
  - README.md
  - CHANGELOG.md
  - LICENSE
  - .gitignore
  - .pkgmeta
